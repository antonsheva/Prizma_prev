<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="mainScreenBackground">
        <item name="android:background"> @color/mainBcgrndClr</item>
        <item name="borderRound">25dp</item>
        <item name="borderWidth">2px</item>
    </style>

    <style name="sMainButtonPattern">
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:layout_centerInParent">true</item>
        <item name="android:padding">5dp</item>
    </style>

    <style name="sRangesButtonPattern">
        <item name="android:layout_width">match_parent</item>

        <item name="android:layout_centerInParent">true</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">3dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>

    </style>

    <style name="sRangesText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>


</resources>