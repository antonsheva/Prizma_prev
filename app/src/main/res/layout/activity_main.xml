<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="50dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/main_background"
        android:orientation="vertical"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"

      >
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp">
            <TextView
                android:id="@+id/swVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mTextColor"
                android:text="Призма вер. 1.0"
                android:textSize="20sp"
                android:textStyle="bold"
                />
            <ImageView
                android:id="@+id/btDevInfo"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/bt_dev_info"
                android:layout_alignParentEnd="true"
                app:tint="@color/mTextColor"
                android:layout_marginEnd="80dp"
                android:visibility="gone"
                />
            <ImageView
                android:id="@+id/btUpdateDevList"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/update_arrow_0"
                android:layout_alignParentEnd="true"
                app:tint="@color/mTextColor"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="40dp"
                android:visibility="gone"/>

            <ImageView
                android:id="@+id/btSearch"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/bt_enable"
                android:layout_alignParentEnd="true"
                app:tint="@color/mTextColor" />



        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/mainLV"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/main_background">

            </ListView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.2">
            <RelativeLayout
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                >
                <LinearLayout
                    android:id="@+id/sMainButtonSuppress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Подавление"
                    android:layout_centerInParent="true"
                    android:background="@drawable/button_suppress_off"
                    android:padding="10dp"

                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Подавление"
                        android:textSize="25dp"
                        android:textColor="@color/white"
                        android:textStyle="bold"

                        />
                </LinearLayout>

            </RelativeLayout>

        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.3">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="5dp"
                    android:layout_alignParentBottom="true"
                    android:layout_marginBottom="70dp"
                    >
                    <RelativeLayout
                        android:id="@+id/sMainButtonPatt1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/sMainButtonPattern"
                        android:background="@drawable/button_pattern"

                        >
                        <TextView
                            android:id="@+id/sMainButtonPatt1Txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DJI 2.4"
                            android:textSize="18dp"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:layout_centerInParent="true"
                            />
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/sMainButtonPatt2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/sMainButtonPattern"
                        android:background="@drawable/button_pattern"
                        >
                        <TextView
                            android:id="@+id/sMainButtonPatt2Txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="868 МГц"
                            android:textSize="18dp"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:layout_centerInParent="true"
                            />
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/sMainButtonPatt3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/sMainButtonPattern"
                        android:background="@drawable/button_pattern_select"
                        >
                        <TextView
                            android:id="@+id/sMainButtonPatt3Txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GPS"
                            android:textSize="18dp"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:layout_centerInParent="true"
                            />
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/sMainButtonPatt4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/sMainButtonPattern"
                        android:background="@drawable/button_pattern"
                        >
                        <TextView
                            android:id="@+id/sMainButtonPatt4Txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5.8 ГГц"
                            android:textSize="18dp"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:layout_centerInParent="true"
                            />
                    </RelativeLayout>




                </LinearLayout>
                <RelativeLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="5dp"
                    android:layout_marginBottom="10dp"
                    android:layout_alignParentBottom="true"
                    >
                    <LinearLayout
                        android:id="@+id/sMainButtonRanges"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/sMainButtonPattern"
                        android:background="@drawable/button_pattern"
                        android:layout_alignParentStart="true"
                        >
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Диапазоны"
                            android:textSize="18dp"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:layout_centerInParent="true"
                            />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/sMainButtonMode14Hz"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/sMainButtonPattern"
                        android:background="@drawable/button_pattern"
                        android:layout_alignParentEnd="true"
                        >
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Режим 14 Гц"
                            android:textSize="18dp"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:layout_centerInParent="true"
                            />
                    </LinearLayout>





                </RelativeLayout>
            </RelativeLayout>


        </LinearLayout>






    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>